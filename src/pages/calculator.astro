---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProFormaCalculator from '../components/ProFormaCalculator.tsx';
import ReturnOnCostChart from '../components/ReturnOnCostChart.tsx';
---

<BaseLayout
  title="Pro Forma Calculator"
  description="The same hypothetical 40-unit multifamily building, modeled market by market. Change the inputs and see what pushes the deal below a required return."
>
  <section class="section calc-page">
    <div class="container">
      <p class="eyebrow">Interactive</p>
      <h1 class="calc-page__heading">One building. Every city's assumptions.</h1>
      <p class="standfirst">
        Every report leans on this model as one piece of evidence: a
        hypothetical 40-unit multifamily building, priced with that city's
        land cost, permit timeline, construction cost, rents, and financing
        terms. Change any input and watch return on cost move against the
        required threshold.
      </p>
    </div>
  </section>

  <section class="section calc-page__calc">
    <div class="container">
      <ProFormaCalculator client:visible initialPresetKey="dc" showPresetSwitcher={true} />
    </div>
  </section>

  <section class="section calc-page__chart" data-reveal>
    <div class="container">
      <ReturnOnCostChart client:visible />
    </div>
  </section>
</BaseLayout>

<style>
  .calc-page__heading {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    max-width: 20ch;
  }

  .calc-page__calc {
    padding-top: 0;
  }

  .calc-page__chart {
    padding-top: 0;
  }
</style>
