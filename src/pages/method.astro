---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlainH3 from '../components/PlainH3.astro';

// general.md is the shared explainer. Every other file in
// src/content/method/ is one report's section, shown in `order`.
const entries = await getCollection('method');

const general = entries.find((e) => e.data.kind === 'general');
if (!general || general.data.kind !== 'general') {
  throw new Error('src/content/method/general.md is missing');
}
const { title, standfirst } = general.data;
const { Content: GeneralContent } = await general.render();

const reports = await Promise.all(
  entries
    .flatMap((e) => (e.data.kind === 'report' ? [{ entry: e, data: e.data }] : []))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async ({ entry, data }) => ({
      data,
      id: data.reportNumber.toLowerCase(),
      Content: (await entry.render()).Content,
    }))
);
---

<BaseLayout title={title} description={standfirst}>
  <header class="method-head">
    <div class="container">
      <h1 class="method-head__name">{title}</h1>
    </div>
    <div class="container method-head__dek">
      <p class="standfirst">{standfirst}</p>
    </div>
  </header>

  <div class="container method-layout">
    <div class="method-prose measure">
      <GeneralContent />

      {
        reports.map(({ data, id, Content }) => (
          <section class="method-report" aria-labelledby={id}>
            <h2 id={id}>
              {data.reportNumber} · {data.city}
            </h2>
            <Content components={{ h3: PlainH3 }} />
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .method-head {
    padding-top: var(--space-8);
  }

  .method-head__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.5rem, 3rem + 6vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .method-head__name {
      font-size: clamp(2.75rem, 16vw, 5rem);
    }
  }

  .method-head__dek {
    margin-top: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .method-head__dek .standfirst {
    margin: 0;
  }

  .method-layout {
    padding-bottom: var(--space-9);
  }

  .method-prose {
    margin-inline: auto;
    margin-top: var(--space-8);
  }

  /* Same prose as the report pages. */
  .method-prose :global(h2) {
    font-size: 1.6rem;
    margin-top: var(--space-9);
    margin-bottom: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    /* Clear the sticky masthead when a link lands on a section. */
    scroll-margin-top: 88px;
  }

  .method-prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-top: var(--space-7);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .method-prose :global(p) {
    color: var(--color-text-soft);
    margin-bottom: var(--space-5);
    font-size: 1.02rem;
  }

  .method-prose > :global(p:first-child) {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .method-prose :global(ul) {
    margin-bottom: var(--space-5);
    padding-left: 1.4em;
    list-style: disc;
  }

  .method-prose :global(li) {
    color: var(--color-text-soft);
    margin-bottom: var(--space-2);
  }

  .method-prose :global(strong) {
    color: var(--color-text);
  }

  .method-prose :global(:is(p, li) a) {
    color: var(--color-text);
    text-decoration-color: var(--color-border);
    text-underline-offset: 2px;
  }

  .method-prose :global(:is(p, li) a:hover) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
