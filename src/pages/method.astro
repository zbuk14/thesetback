---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// general.md is the shared, city-free explainer. The cards at the end are
// generated: one per report that has a numbers page.
const general = await getEntry('method', 'general');
if (!general) throw new Error('src/content/method/general.md is missing');
const { title, standfirst } = general.data;
const { Content } = await general.render();

const constraintLabel: Record<string, string> = {
  regulatory: 'Regulatory',
  capital: 'Capital',
  structural: 'Structural',
  cost: 'Cost-driven',
};

const numbers = await getCollection('numbers');
const cities = (
  await Promise.all(
    numbers.map(async (entry) => {
      const report = await getEntry('reports', entry.data.report);
      if (!report) return null;
      const { reportNumber, city, constraintTypes } = report.data;
      return {
        reportNumber,
        city,
        constraint: constraintTypes.map((c) => constraintLabel[c]).join(' + '),
        href: `/reports/${report.slug}/numbers#inputs`,
      };
    })
  )
)
  .filter((c) => c !== null)
  .sort((a, b) => a.reportNumber.localeCompare(b.reportNumber));
---

<BaseLayout title={title} description={standfirst}>
  <header class="method-head">
    <div class="container">
      <h1 class="method-head__name">{title}</h1>
    </div>
    <div class="container method-head__dek">
      <p class="standfirst">{standfirst}</p>
    </div>
  </header>

  <div class="container method-layout">
    <div class="method-prose measure">
      <Content />

      <ul class="method-cities">
        {
          cities.map((c) => (
            <li>
              <a class="method-city" href={c.href}>
                <span class="method-city__number mono">{c.reportNumber}</span>
                <span class="method-city__name">{c.city}</span>
                <span class="method-city__constraint mono">{c.constraint}</span>
                <span class="method-city__go mono">Inputs, sources and full model →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .method-head {
    padding-top: var(--space-8);
  }

  .method-head__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.5rem, 3rem + 6vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .method-head__name {
      font-size: clamp(2.75rem, 16vw, 5rem);
    }
  }

  .method-head__dek {
    margin-top: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .method-head__dek .standfirst {
    margin: 0;
  }

  .method-layout {
    padding-bottom: var(--space-9);
  }

  .method-prose {
    margin-inline: auto;
    margin-top: var(--space-8);
  }

  /* Same prose as the report pages. */
  .method-prose :global(h2) {
    font-size: 1.6rem;
    margin-top: var(--space-9);
    margin-bottom: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    /* Clear the sticky masthead when a link lands on a section. */
    scroll-margin-top: 88px;
  }

  .method-prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-top: var(--space-7);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .method-prose :global(p) {
    color: var(--color-text-soft);
    margin-bottom: var(--space-5);
    font-size: 1.02rem;
  }

  .method-prose > :global(p:first-child) {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .method-prose :global(ul) {
    margin-bottom: var(--space-5);
    padding-left: 1.4em;
    list-style: disc;
  }

  .method-prose :global(li) {
    color: var(--color-text-soft);
    margin-bottom: var(--space-2);
  }

  .method-prose :global(strong) {
    color: var(--color-text);
  }

  .method-prose :global(:is(p, li) a) {
    color: var(--color-text);
    text-decoration-color: var(--color-border);
    text-underline-offset: 2px;
  }

  .method-prose :global(:is(p, li) a:hover) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* City cards. Generated, so a new report appears on its own. */
  .method-prose :global(ul.method-cities) {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
    border-top: 1px solid var(--color-border);
  }

  .method-prose :global(ul.method-cities li) {
    margin: 0;
  }

  .method-city {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    grid-template-areas:
      'number name constraint'
      '. go go';
    column-gap: var(--space-5);
    row-gap: var(--space-2);
    align-items: baseline;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border-soft);
    text-decoration: none;
    color: var(--color-text);
  }

  .method-city__number {
    grid-area: number;
    font-size: 0.72rem;
    color: var(--color-accent-deep);
  }

  .method-city__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .method-city__constraint {
    grid-area: constraint;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .method-city__go {
    grid-area: go;
    font-size: 0.78rem;
    color: var(--color-accent-deep);
  }

  .method-city:hover .method-city__go {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 520px) {
    .method-city {
      grid-template-columns: 3.5rem 1fr;
      grid-template-areas:
        'number name'
        '. constraint'
        '. go';
    }
  }
</style>
