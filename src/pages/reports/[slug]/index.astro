---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ReportLayout from '../../../layouts/ReportLayout.astro';
import Scorecard from '../../../components/Scorecard.astro';
import SourcedScorecard from '../../../components/SourcedScorecard.astro';
import PlaceholderFigure from '../../../components/PlaceholderFigure.astro';
import SetbackDivider from '../../../components/SetbackDivider.astro';
import SourcesTable from '../../../components/SourcesTable.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'reports'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  city,
  dek,
  reportNumber,
  status,
  constraintTypes,
  scorecard,
  heroImage,
  heroImageAlt,
  heroCaption,
  heroCredit,
  heroImagePosition,
  publishDate,
  dataVintage,
  proFormaPreset,
  proFormaData,
  author,
} = entry.data;

// Reports with a sourced data file (currently only R-01) render their
// scorecard from that file's `scorecard` array: arbitrary row count,
// per-row source link. The still-unsourced stub reports use the fixed
// 5-metric shape. Vite needs a static glob (not a template-literal
// dynamic import) to resolve these at build time.
const sourcedDataFiles = import.meta.glob('../../../data/*.json', { eager: true }) as Record<
  string,
  { default: { scorecard: Array<{ id: string; metric: string; value: string; vintage: string; source_url: string }> } }
>;
const sourcedScorecard = proFormaData
  ? sourcedDataFiles[`../../../data/${proFormaData}.json`]?.default.scorecard ?? null
  : null;

// A report that sets neither carries its own scorecard in the body, where
// the author wants it (R-02), so the shell does not add one above the prose.
const showTopScorecard = Boolean(sourcedScorecard || scorecard);
---

<ReportLayout
  title={`${reportNumber} · ${city}`}
  description={dek}
  reportNumber={reportNumber}
  status={status}
  constraintTypes={constraintTypes}
  dataVintage={dataVintage}
  publishDate={publishDate}
  headline={city}
  dek={dek}
  author={author}
>
  <Fragment slot="hero">
    {
      heroImage ? (
        <figure class="report-hero__figure">
          <Image
            src={heroImage}
            alt={heroImageAlt ?? `${city}`}
            widths={[600, 1200, 1600]}
            sizes="100vw"
            loading="eager"
            style={heroImagePosition ? `object-position: ${heroImagePosition}` : undefined}
          />
          {(heroCaption || heroCredit) && (
            <figcaption class="figure-image__caption">
              {heroCaption && <span>{heroCaption}</span>}
              {heroCredit && (
                <span class="figure-image__credit mono">
                  {heroCaption ? ' · Photo: ' : 'Photo: '}
                  <a href={heroCredit.authorUrl}>{heroCredit.author}</a>
                  {' / '}
                  <a href={heroCredit.sourceUrl}>{heroCredit.source}</a>
                </span>
              )}
            </figcaption>
          )}
        </figure>
      ) : (
        <PlaceholderFigure label={`${city}: photography pending`} slim />
      )
    }
  </Fragment>

  <Fragment slot="before-prose">
    {showTopScorecard && (
    <section class="report-scorecard" aria-labelledby="scorecard-heading" data-reveal>
      <p class="eyebrow">Supply Scorecard</p>
      <h2 id="scorecard-heading">How {city} measures up</h2>
      <div class="report-scorecard__table">
        {sourcedScorecard ? (
          <SourcedScorecard scorecard={sourcedScorecard} />
        ) : (
          <Scorecard scorecard={scorecard} />
        )}
      </div>
      {!sourcedScorecard && (
        <p class="mono report-scorecard__note">
          Figures are provisional pending source verification against the
          Census Building Permits Survey, HUD, FRED, and municipal planning
          data.
        </p>
      )}
    </section>
    )}

    {showTopScorecard && <SetbackDivider />}
  </Fragment>

  <Content />

  <Fragment slot="after-prose">
    {proFormaPreset && !proFormaData && <SourcesTable cityKey={proFormaPreset} />}
  </Fragment>
</ReportLayout>

<style>
  .report-scorecard {
    max-width: var(--width-measure);
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .report-scorecard h2 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .report-scorecard__note {
    margin-top: var(--space-4);
    font-size: 0.7rem;
    color: var(--color-muted);
  }
</style>
