---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  wide?: boolean;
}

const { src, alt, caption, credit, wide = false } = Astro.props;
---

<figure class:list={['figure-image', { 'figure-image--wide': wide }]}>
  <Image src={src} alt={alt} widths={[400, 800, 1200]} sizes="(max-width: 720px) 100vw, 720px" />
  {
    (caption || credit) && (
      <figcaption class="figure-image__caption">
        {caption && <span>{caption}</span>}
        {credit && <span class="figure-image__credit mono"> · {credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure-image {
    margin-block: var(--space-6);
  }

  .figure-image :global(img) {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  .figure-image--wide {
    max-width: none;
  }
</style>
