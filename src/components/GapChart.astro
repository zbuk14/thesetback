---
import dcData from '../data/dc-proforma.json';

// Defaults are the D.C. figures. Another city passes its own, as decimals
// (0.0318 = 3.18%), and may rename the three labels.
interface Props {
  earns?: number;
  reach?: number;
  needs?: number;
  earnsLabel?: string;
  needsLabel?: string;
  /** Label for the zoning segment. */
  reachLabel?: string;
  /** Append the zoning-package return to reachLabel. */
  showReachValue?: boolean;
  caption?: string;
}

const {
  earns = dcData.outputs.return_on_cost,
  reach = dcData.outputs.regulatory_ceiling_roc,
  needs = dcData.outputs.required_return,
  earnsLabel = 'Earns',
  needsLabel = 'Needs',
  reachLabel = 'Everything zoning reform can do',
  showReachValue = false,
  caption = 'Grant every reform at once and the building still does not work.',
} = Astro.props;

const totalRange = needs - earns;
const reachFraction = (reach - earns) / totalRange;
const shortFraction = 1 - reachFraction;

function pct(v: number) {
  return `${(v * 100).toFixed(1)}%`;
}

const reachText = showReachValue ? `${reachLabel} ${pct(reach)}` : reachLabel;
---

<div class="gap-chart" data-reveal>
  <div class="gap-chart__endpoints">
    <span class="gap-chart__endpoint">{earnsLabel} {pct(earns)}</span>
    <span class="gap-chart__endpoint gap-chart__endpoint--right">{needsLabel} {pct(needs)}</span>
  </div>

  <div
    class="gap-chart__bar"
    role="img"
    aria-label={`Bar from ${pct(earns)}, what the building earns, to ${pct(needs)}, what it needs. The segment from ${pct(earns)} to ${pct(reach)} shows everything zoning reform can do. The remaining segment to ${pct(needs)} is still short.`}
  >
    <div class="gap-chart__segment gap-chart__segment--reach" style={`flex-basis: ${reachFraction * 100}%`} />
    <div class="gap-chart__segment gap-chart__segment--short" style={`flex-basis: ${shortFraction * 100}%`} />
  </div>

  <div class="gap-chart__labels">
    <span class="gap-chart__label gap-chart__label--reach" style={`flex-basis: ${reachFraction * 100}%`}>
      {reachText}
    </span>
    <span class="gap-chart__label gap-chart__label--short" style={`flex-basis: ${shortFraction * 100}%`}>
      Still short
    </span>
  </div>

  <p class="mono gap-chart__caption">{caption}</p>
</div>

<style>
  .gap-chart {
    background: var(--pure-paper);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-6);
    /* Same space below as a table in report prose. */
    margin-bottom: var(--space-6);
  }

  @media (max-width: 640px) {
    .gap-chart {
      padding: var(--space-4);
    }
  }

  .gap-chart__endpoints {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .gap-chart__bar {
    display: flex;
    height: 40px;
    border-radius: 3px;
    overflow: hidden;
  }

  .gap-chart__segment--reach {
    background: var(--accent);
  }

  .gap-chart__segment--short {
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 4px,
      rgba(58, 107, 126, 0.35) 4px,
      rgba(58, 107, 126, 0.35) 8px
    );
    border: 1.5px solid var(--ink);
    margin-left: -1.5px;
  }

  .gap-chart__labels {
    display: flex;
    margin-top: var(--space-3);
  }

  .gap-chart__label {
    font-size: 0.8rem;
    color: var(--color-text-soft);
    text-align: center;
    padding-inline: var(--space-2);
  }

  .gap-chart__label--reach {
    color: var(--color-accent-deep);
  }

  @media (max-width: 640px) {
    .gap-chart__labels {
      flex-direction: column;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }

    .gap-chart__label {
      flex-basis: auto !important;
      text-align: left;
      padding-inline: 0;
    }
  }

  .gap-chart__caption {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
    font-size: 0.72rem;
    color: var(--color-muted);
  }
</style>
