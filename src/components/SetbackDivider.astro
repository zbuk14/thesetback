---
interface Props {
  variant?: 'ink' | 'paper';
  class?: string;
}

const { variant = 'ink', class: className = '' } = Astro.props;
const stroke = variant === 'ink' ? 'var(--rule)' : 'rgba(247,245,240,0.3)';
---

<div class:list={['setback-divider', className]} role="presentation" aria-hidden="true">
  <svg
    viewBox="0 0 1200 32"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M0 28 H180 V20 H360 V20 H480 V12 H700 V12 H860 V4 H1200"
      stroke={stroke}
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>
</div>

<style>
  .setback-divider {
    width: 100%;
    height: 32px;
    overflow: hidden;
  }

  .setback-divider svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
