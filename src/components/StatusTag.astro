---
interface Props {
  status: 'published' | 'draft' | 'draft-sourced' | 'in-progress' | 'upcoming';
}

const { status } = Astro.props;

const labels: Record<Props['status'], string> = {
  published: 'Published',
  draft: 'Draft',
  'draft-sourced': 'Draft · Sourced',
  'in-progress': 'In Progress',
  upcoming: 'Upcoming',
};
---

<span class={`status-tag status-tag--${status}`}>{labels[status]}</span>
